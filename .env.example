# ==============================================================================
# Student Performance Analysis System - Environment Configuration Template
# Copy this file to '.env' and populate with your local database credentials.
# NOTE: Never commit your actual '.env' file containing real passwords to Git!
# ==============================================================================

# Database Connection Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password_here
DB_NAME=student_performance

# Flask Application Settings
# In production, set FLASK_DEBUG=False and use a strong, random SECRET_KEY.
SECRET_KEY=change_this_to_a_secure_random_key_in_production
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Academic & Analytics Policy Configuration
# SUPPORT_THRESHOLD: Percentage threshold under which students are flagged for academic support.
SUPPORT_THRESHOLD=40.0
# TOP_N: Number of top-performing students displayed in the dashboard showcase.
TOP_N=3
# ASSESSMENT_AGGREGATION: Method to aggregate multiple assessments for a subject (AVERAGE, BEST, LATEST)
ASSESSMENT_AGGREGATION=AVERAGE
